# /etc/default/talkiepi — Debian defaults file (EnvironmentFile for systemd)
# Service-level knobs only; structured settings live in /etc/talkiepi/talkiepi.yaml

#TALKIEPI_CONFIG=/etc/talkiepi/talkiepi.yaml
#TALKIEPI_WEB_HOST=0.0.0.0
#TALKIEPI_WEB_PORT=8080
#TALKIEPI_LOGGING_LEVEL=info
#TALKIEPI_STATE_DIR=/var/lib/talkiepi
#TALKIEPI_ARGS=

# Optional Mumble overrides (also available via YAML)
#TALKIEPI_SERVER_ADDRESS=
#TALKIEPI_SERVER_PORT=64738
#TALKIEPI_SERVER_USERNAME=
#TALKIEPI_SERVER_AUTO_DISCOVER=true

# GPIO push-to-talk (Raspberry Pi / Linux)
#TALKIEPI_TRIGGERS_GPIO_ENABLED=false
#TALKIEPI_TRIGGERS_GPIO_CHIP=gpiochip0
#TALKIEPI_TRIGGERS_GPIO_LINE=17
#TALKIEPI_TRIGGERS_ACTIVE_LOW=true

# Voice mode: push_to_talk | always_on | communicator
#TALKIEPI_VOICE_MODE=push_to_talk
